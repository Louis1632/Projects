    "@fastify/swagger-ui": "^6.1.2",
    "@node-rs/argon2": "^2.2.2",
    "@tido/contracts": "workspace:*",
    "@tido/db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "postgres": "^3.4.9",
    "rrule": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
