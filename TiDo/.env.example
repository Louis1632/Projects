# Local development only. Copy to .env and replace values; never commit .env.
DATABASE_URL=postgresql://tido:tido@localhost:5432/tido
# Integration and E2E tests create and reset this database.
TEST_DATABASE_URL=postgresql://tido:tido@localhost:5432/tido_test
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-32-byte-secret
SESSION_COOKIE_NAME=tido_session
COOKIE_SECURE=false
WORKSPACE_TIMEZONE=Africa/Johannesburg
BOOTSTRAP_OWNER_EMAIL=owner@example.test
BOOTSTRAP_OWNER_NAME=TiDo Owner
BOOTSTRAP_WORKSPACE_NAME=Home
