{
  "name": "tido",
  "version": "0.1.0",
  "private": true,
  "description": "A secure, shared, self-hosted task workspace.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm --filter @tido/api dev\" \"pnpm --filter @tido/web dev\"",
    "dev:api": "pnpm --filter @tido/api dev",
    "dev:web": "pnpm --filter @tido/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @tido/api test:integration",
    "test:e2e": "pnpm --filter @tido/web test:e2e",
    "db:generate": "pnpm --filter @tido/db generate",
    "db:migrate": "pnpm --filter @tido/db migrate",
    "db:bootstrap-owner": "pnpm --filter @tido/db bootstrap-owner",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
